# ---------------------------------------------------------------------------
# PromptShield configuration. Copy to `.env` and fill in real values.
# NEVER commit the real .env file — it is git-ignored.
# ---------------------------------------------------------------------------

# HTTP server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# API authentication.
# Comma-separated list of accepted client API keys for PromptShield's own
# endpoints. Leave blank to DISABLE auth (development only).
PROMPTSHIELD_API_KEYS=

# Redaction policy: default action for detected entities.
# One of: redact | mask | block | allow
DEFAULT_ACTION=redact

# Per-API-key policies (JSON object). Maps an API key to its own policy
# ({ default?, overrides? }), layered between per-request policy and the server
# default. Keys named here are ALSO accepted as valid auth keys. Example:
# PROMPTSHIELD_KEY_POLICIES={"tenant-a-key":{"default":"block"},"tenant-b-key":{"overrides":{"EMAIL":"mask"}}}
PROMPTSHIELD_KEY_POLICIES=

# Custom detection rules (JSON array). Each rule needs a "name" plus either a
# "pattern" (regex source, "flags" optional) or "terms" (list of literals).
# Example:
# PROMPTSHIELD_CUSTOM_RULES=[{"name":"employee id","pattern":"EMP-\\d{5}"},{"name":"codename","terms":["Project Titan","Bluebird"]}]
PROMPTSHIELD_CUSTOM_RULES=

# Audit sink: where redaction events are recorded.
# One of: none | stdout | file
AUDIT_SINK=file
AUDIT_FILE=./data/audit.jsonl

# ---------------------------------------------------------------------------
# OpenAI-compatible proxy (optional — only needed for the /v1/chat/completions
# transparent proxy surface).
# ---------------------------------------------------------------------------

# Upstream model provider base URL (OpenAI-compatible).
UPSTREAM_BASE_URL=https://api.openai.com/v1

# The upstream provider API key. This is injected server-side so clients never
# need to hold the real provider key.
UPSTREAM_API_KEY=

# Rehydrate provider responses? If true, redaction placeholders found in the
# model's response are swapped back to original values before returning.
REHYDRATE_RESPONSES=true
